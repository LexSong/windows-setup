{
  "model": "opus",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark",
  "permissions": {
    "deny": [
      "Bash(ruff format *)",
      "Bash(ruff check --fix *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/windows-setup/scripts/project-checkup.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
